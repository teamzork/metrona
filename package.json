{
  "name": "metrona",
  "version": "1.0.0",
  "description": "Website analytics from your server logs: no script, no cookies, no database",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "echo 'JavaScript codebase - no build step required'",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "analytics",
    "privacy",
    "self-hosted",
    "nginx",
    "web-analytics",
    "caddy",
    "mcp"
  ],
  "author": "Dmitri Zdorov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamzork/metrona.git"
  }
}
