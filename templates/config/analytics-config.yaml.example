# Metrona Analytics System Configuration
# Copy this file to /etc/analytics/config.yaml and customize

version: 1

# Storage configuration
storage:
  data_path: /var/analytics/data
  backup_enabled: true
  retention_days: 365

# Dashboard configuration
dashboard:
  enabled: true
  port: 3001
  # Generate password hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
  password_hash: $2b$12$example.hash.replace.with.actual.hash
  rate_limit: 10  # requests per minute

# Site configurations
sites:
  - domain: example.com
    nginx_config: /etc/nginx/sites-available/example.com
    log_path: /var/log/nginx/example.com-analytics.log
    frequency: daily  # daily, hourly, or cron expression like "0 */6 * * *"
    enabled: true
    exclusions:
      - /admin/*
      - /api/health
      - "*.css"
      - "*.js"
      - "*.png"
      - "*.jpg"
      - "*.gif"
      - "*.svg"
      - "*.ico"
  
  # Add more sites as needed
  # - domain: blog.example.com
  #   nginx_config: /etc/nginx/sites-available/blog
  #   log_path: /var/log/nginx/blog-analytics.log
  #   frequency: "0 */6 * * *"  # every 6 hours
  #   enabled: true