{
  "name": "@metrona/scheduler",
  "version": "1.0.0",
  "description": "Cron daemon for automated analytics processing",
  "license": "MIT",
  "homepage": "https://github.com/teamzork/metrona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamzork/metrona.git",
    "directory": "packages/scheduler"
  },
  "bugs": "https://github.com/teamzork/metrona/issues",
  "main": "src/index.js",
  "bin": {
    "metrona-scheduler": "src/daemon.js"
  },
  "scripts": {
    "build": "echo 'No build step needed for JavaScript'",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist && find . -name '*.d.ts' -delete && find . -name '*.d.ts.map' -delete",
    "lint": "eslint src/**/*.js",
    "start": "node src/daemon.js"
  },
  "dependencies": {
    "@metrona/dashboard": "^1.0.0",
    "@metrona/parser": "^1.0.0",
    "@metrona/shared": "^1.0.0",
    "chokidar": "^3.5.3",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "fast-check": "^3.15.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.spec.js",
    "!src/**/*-property-test.js",
    "!src/**/*-verification.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
