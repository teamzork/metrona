    "clean": "rm -rf dist && find . -name '*.d.ts' -delete && find . -name '*.d.ts.map' -delete",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "@metrona/shared": "^1.0.0",
    "date-fns": "^2.30.0",
    "fast-glob": "^3.3.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "fast-check": "^3.15.0",
    "jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.spec.js",
    "!src/**/*-property-test.js",
    "!src/**/*-verification.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
