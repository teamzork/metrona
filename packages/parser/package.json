{
  "name": "@metrona/parser",
  "version": "1.0.0",
  "description": "Log parser and analytics engine for Metrona Analytics System",
  "license": "MIT",
  "homepage": "https://github.com/teamzork/metrona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamzork/metrona.git",
    "directory": "packages/parser"
  },
  "bugs": "https://github.com/teamzork/metrona/issues",
  "main": "src/index.js",
  "scripts": {
    "build": "echo 'No build step needed for JavaScript'",
