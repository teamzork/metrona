{
  "name": "@analytics-system/dashboard",
  "version": "1.0.0",
  "description": "Central monitoring dashboard for Metrona Analytics System",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "echo 'Client build complete'",
    "build:server": "tsc",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.js",
    "start": "node dist/server/index.js",
    "serve": "http-server public -p 3001"
  },
  "dependencies": {
    "@analytics-system/shared": "^1.0.0",
    "express": "^4.18.0",
    "express-session": "^1.17.0",
    "express-rate-limit": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "fast-check": "^3.15.0",
    "typescript": "^5.0.0",
    "http-server": "^14.1.0"
  },
  "files": [
    "dist",
    "public"
  ]
}