{
  "name": "@analytics-system/dashboard",
  "version": "1.0.0",
  "description": "Central monitoring dashboard for Metrona Analytics System",
  "main": "src/index.js",
  "scripts": {
    "build": "echo 'No build step needed for JavaScript'",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist && find . -name '*.d.ts' -delete && find . -name '*.d.ts.map' -delete",
    "lint": "eslint src/**/*.js",
    "start": "node src/index.js",
    "serve": "http-server public -p 3001"
  },
  "dependencies": {
    "@analytics-system/shared": "^1.0.0",
    "express": "^4.18.0",
    "express-session": "^1.17.0",
    "express-rate-limit": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "fast-check": "^3.15.0",
    "typescript": "^5.0.0",
    "http-server": "^14.1.0"
  },
  "files": [
    "public"
  ]
}