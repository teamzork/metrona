{
  "name": "@metrona/dashboard",
  "version": "1.0.0",
  "description": "Central monitoring dashboard for Metrona Analytics System",
  "license": "MIT",
  "homepage": "https://github.com/teamzork/metrona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamzork/metrona.git",
    "directory": "packages/dashboard"
  },
  "bugs": "https://github.com/teamzork/metrona/issues",
  "main": "src/index.js",
  "scripts": {
    "build": "echo 'No build step needed for JavaScript'",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist && find . -name '*.d.ts' -delete && find . -name '*.d.ts.map' -delete",
    "lint": "eslint src/**/*.js",
    "start": "node src/start.js",
    "serve": "http-server public -p 3001"
  },
  "dependencies": {
    "@metrona/shared": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.18.0",
    "express-rate-limit": "^7.1.0",
    "express-session": "^1.17.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "fast-check": "^3.15.0",
    "http-server": "^14.1.0",
    "jest": "^29.0.0",
    "supertest": "^6.3.4",
    "typescript": "^5.0.0"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.spec.js",
    "!src/**/*-property-test.js",
    "!src/**/*-verification.js",
    "public"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
